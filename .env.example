# Trading Agent Configuration
# Copy this file to .env and fill in your values

# General
LOG_LEVEL=INFO
PAPER_TRADING=true

# Alpaca (Stock Broker)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Crypto Exchange (e.g. Coinbase, Binance)
CRYPTO_EXCHANGE=coinbase
CRYPTO_API_KEY=
CRYPTO_SECRET_KEY=

# Data Providers
YAHOO_FINANCE_ENABLED=true
