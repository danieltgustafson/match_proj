# Trading Agent Configuration
# Copy this file to .env and fill in your values

# General
LOG_LEVEL=INFO
PAPER_TRADING=true

# Broker: paper, alpaca, ibkr, schwab
BROKER=paper

# Alpaca Markets (https://app.alpaca.markets/signup)
# Paper trading is free -- sign up and get API keys
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Interactive Brokers (requires TWS or IB Gateway running)
# Port: 7497=TWS paper, 7496=TWS live, 4002=Gateway paper, 4001=Gateway live
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# Crypto Exchange (e.g. Coinbase, Binance)
CRYPTO_EXCHANGE=coinbase
CRYPTO_API_KEY=
CRYPTO_SECRET_KEY=

# Data Providers
YAHOO_FINANCE_ENABLED=true
ALPHA_VANTAGE_API_KEY=

# News / Sentiment
NEWS_API_KEY=                # https://newsapi.org (free tier: 100 req/day)
RAPIDAPI_KEY=                # https://rapidapi.com (for Seeking Alpha data)

# Watchlist (comma-separated ticker symbols)
WATCHLIST=AAPL,MSFT,GOOGL,AMZN,NVDA

# Trading Schedule (seconds between runs)
RUN_INTERVAL_SECONDS=900

# Risk Management
MAX_DRAWDOWN_PCT=0.15
MAX_POSITION_PCT=0.10
MAX_DAILY_LOSS_PCT=0.03

# Position Sizing: kelly, risk_parity, fixed_fractional
SIZING_METHOD=kelly
KELLY_FRACTION=0.5
