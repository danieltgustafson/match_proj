# Systemd service file for the trading agent
# Install: sudo cp trading-agent.service /etc/systemd/system/
# Enable:  sudo systemctl enable trading-agent
# Start:   sudo systemctl start trading-agent
# Logs:    journalctl -u trading-agent -f

[Unit]
Description=Trading Agent - Automated Stock & Crypto Trading
After=network.target

[Service]
Type=simple
User=trading
Group=trading
WorkingDirectory=/opt/trading-agent
ExecStart=/opt/trading-agent/.venv/bin/python -m trading_agent --scan --schedule
Restart=always
RestartSec=30

# Environment
EnvironmentFile=/opt/trading-agent/.env

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trading-agent

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/trading-agent/data

[Install]
WantedBy=multi-user.target
